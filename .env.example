PORT=3000
APP_NAME=FINVORA
NODE_ENV=production
APP_ENV=production
APP_URL=http://localhost:3000

# Session & Security
SESSION_SECRET=your_jwt_session_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./data/finvora.sqlite
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finvora?retryWrites=true&w=majority&appName=finvora
MONGODB_DB_NAME=finvora

# MySQL (Alternative configuration if using MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=finvora

# MLM Rules
WORKING_INCOME_MULTIPLIER=3
INVESTOR_INCOME_MULTIPLIER=2
DAILY_ROI_PERCENTAGE=2.0
WITHDRAWAL_FEE_PERCENTAGE=10
REFERRAL_LEVEL_1_PERCENTAGE=10
MIN_WITHDRAWAL=10
MAX_WITHDRAWAL=50000

# Blockchain Configuration (BNB Smart Chain BEP-20 USDT)
BSC_NETWORK=mainnet
BSC_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_FALLBACK_RPCS=https://bsc-dataseed1.defibit.io/,https://bsc-dataseed1.ninicoin.io/,https://binance.llamarpc.com
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ACTIVE_ADMIN_WALLET=0xB34D4644268EA517054117eA0940AE5cA112BD6e
ACTIVE_DEPOSIT_WALLET=0xB34D4644268EA517054117eA0940AE5cA112BD6e
ACTIVE_WITHDRAWAL_WALLET=0xB34D4644268EA517054117eA0940AE5cA112BD6e
WITHDRAWAL_SIGNER_PRIVATE_KEY=0xd4672c985b893e4e4bb8e6391cb5660046b489a47b245001f370c2522dc60ca5
MIN_CONFIRMATIONS=1
BSC_EXPLORER_URL=https://bscscan.com

