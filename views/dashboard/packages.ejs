<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Packages Store' }) %>

      <main class="dashboard-content">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <!-- Store Telemetry Hero Banner -->
        <div class="card" style="margin-bottom: 2rem; background: linear-gradient(135deg, rgba(13, 108, 159, 0.15) 0%, rgba(8, 12, 14, 0.9) 70%); border-color: rgba(55, 165, 161, 0.35); position: relative; overflow: hidden;">
          <div style="position: absolute; right: -20px; bottom: -30px; width: 220px; height: 220px; background: radial-gradient(circle, rgba(87, 193, 157, 0.15) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
          
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; position: relative; z-index: 2;">
            <div>
              <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem;">
                <% if (user.user_type === 'WORKING') { %>
                  <span class="badge badge-working" style="font-size: 0.78rem;">Working ID &bull; 3X (300%) Income Cap</span>
                <% } else if (user.user_type === 'INVESTOR') { %>
                  <span class="badge badge-investor" style="font-size: 0.78rem;">Investor ID &bull; 2X (200%) Income Cap</span>
                <% } else if (user.user_type === 'SUSPENDED') { %>
                  <span class="badge badge-error" style="font-size: 0.78rem;">Suspended Account</span>
                <% } else { %>
                  <span class="badge badge-active" style="font-size: 0.78rem;">Active ID &bull; 2X Cap (Unlock 3X with 1 Referrer)</span>
                <% } %>
                <span style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--c-mint);">
                  <span class="pulse-dot" style="width: 6px; height: 6px;"></span>
                  730% APY Yield Engine
                </span>
              </div>

              <h2 style="font-size: 1.65rem; font-weight: 800; letter-spacing: -0.02em;">
                Institutional <span class="grad-text">Packages Store</span>
              </h2>
              <p class="text-secondary" style="font-size: 0.9rem; margin-top: 0.35rem; max-width: 620px;">
                Select an institutional mining yield contract. Each package activates automated daily 2.0% returns, 5 levels of one-time referral commissions, and unlocks up to 20 levels of ROI residuals.
              </p>
            </div>

            <div style="display: flex; align-items: center; gap: 1rem; background: rgba(5, 5, 5, 0.6); padding: 0.85rem 1.35rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
              <div>
                <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.06em; font-weight: 600;">Main Balance</div>
                <div class="mono" style="font-size: 1.45rem; font-weight: 800; color: var(--c-mint);">$<%= wallet.main_balance.toFixed(2) %></div>
              </div>
              <a href="/deposit" class="btn btn-primary btn-sm" style="padding: 0.55rem 1rem;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                <span>Deposit</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Filter Tabs -->
        <div class="package-filter-bar">
          <button type="button" class="filter-btn active" data-filter="all">All Packages (<%= packages ? packages.length : 0 %>)</button>
          <button type="button" class="filter-btn" data-filter="starter">Starter Tier ($50 - $250)</button>
          <button type="button" class="filter-btn" data-filter="pro">Pro Tier ($500 - $1,000)</button>
          <button type="button" class="filter-btn" data-filter="institutional">Institutional ($2,500 - $10,000)</button>
        </div>

        <!-- Packages Showcase Grid -->
        <div class="grid grid-4" id="packages-grid" style="gap: 1.5rem;">
          <% if (packages && packages.length > 0) { %>
            <% packages.forEach((pkg, index) => { %>
              <% 
                const isWorking = (user.user_type === 'WORKING');
                const multiplier = isWorking ? 3 : 2;
                const dailyEarn = pkg.price * 0.02;
                const monthlyEarn = pkg.price * 0.60;
                const maxCapEarn = pkg.price * multiplier;
                const hasSufficientBalance = wallet.main_balance >= pkg.price;
                const deficit = Math.max(0, pkg.price - wallet.main_balance);
                
                // Categorization
                let category = 'starter';
                if (pkg.price >= 500 && pkg.price <= 1000) category = 'pro';
                else if (pkg.price > 1000) category = 'institutional';

                const isPopular = (pkg.price === 500 || pkg.price === 1000);
              %>
              <div class="package-card <%= isPopular ? 'highlight' : '' %>" data-category="<%= category %>" data-price="<%= pkg.price %>">
                <% if (isPopular) { %>
                  <div class="package-badge-top">Most Popular</div>
                <% } %>

                <div>
                  <div class="package-tier-tag">
                    <%= pkg.code %>
                  </div>
                  <h3 class="package-name"><%= pkg.name %></h3>

                  <div class="package-price">
                    $<%= pkg.price.toLocaleString('en-US') %>
                    <span>USDT</span>
                  </div>

                  <div class="package-yield-banner">
                    <div>
                      <div class="package-yield-sub">Daily 2% ROI</div>
                      <div class="package-yield-val">+$<%= dailyEarn.toFixed(2) %>/d</div>
                    </div>
                    <div style="text-align: right;">
                      <div class="package-yield-sub">30-Day Return</div>
                      <div style="font-size: 0.95rem; font-weight: 700; color: var(--c-mint);">$<%= monthlyEarn.toFixed(2) %></div>
                    </div>
                  </div>

                  <div class="package-return-grid">
                    <div>
                      <div class="return-item-label">Multiplier Cap</div>
                      <div class="return-item-val" style="color: var(--c-mint);"><%= multiplier %>X (<%= multiplier * 100 %>%)</div>
                    </div>
                    <div>
                      <div class="return-item-label">Max Cap Return</div>
                      <div class="return-item-val" style="color: var(--c-lime);">$<%= maxCapEarn.toLocaleString('en-US') %></div>
                    </div>
                  </div>

                  <ul class="package-features">
                    <li>
                      <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                      <span><strong>2.0%</strong> Automated Daily Profit</span>
                    </li>
                    <li>
                      <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                      <span><strong>5-Level</strong> Referral (5%, 2%, 1%, 1%, 1%)</span>
                    </li>
                    <li>
                      <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                      <span>20-Level ROI Residuals Eligible</span>
                    </li>
                    <li>
                      <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                      <span>100% Volume for Weekly Salaries</span>
                    </li>
                  </ul>
                </div>

                <div style="margin-top: 1.25rem;">
                  <% if (hasSufficientBalance) { %>
                    <form action="/packages/purchase" method="POST" class="package-purchase-form" data-package-name="<%= pkg.name %>" data-package-price="$<%= pkg.price.toLocaleString('en-US') %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="packageId" value="<%= pkg.id %>">
                      <button type="submit" class="btn <%= isPopular ? 'btn-primary' : 'btn-outline' %> btn-block">
                        <span>Activate Package</span>
                      </button>
                    </form>
                  <% } else { %>
                    <a href="/deposit" class="btn btn-outline btn-block" style="border-color: rgba(244, 63, 94, 0.4); color: var(--text-secondary);" title="Requires $<%= deficit.toFixed(2) %> more in Main Wallet">
                      <span>Deposit $<%= deficit.toFixed(0) %> More</span>
                    </a>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/dashboard.js"></script>
  <script>
    // Interactive Package Filtering
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        const cards = document.querySelectorAll('#packages-grid .package-card');

        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</body>
</html>
