<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Referral Income' }) %>

      <main class="dashboard-content">
        <div class="kpi-grid" style="margin-bottom: 2rem;">
          <div class="kpi-card">
            <div class="kpi-title">Total Referral Commission Earned</div>
            <div class="kpi-value grad-text">$<%= totalEarned.toFixed(2) %></div>
            <div class="kpi-sub">5-Level Referral Matrix (5%, 2%, 1%, 1%, 1%)</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span>Referral Commission Transactions</span>
            </div>
            <span class="badge badge-success">5-Level Matrix</span>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Ref ID</th>
                  <th>Generation</th>
                  <th>Purchased By</th>
                  <th>Package Volume</th>
                  <th>Commission Rate</th>
                  <th>Earned Amount</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (commissions && commissions.length > 0) { %>
                  <% commissions.forEach(c => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint);">#REF-<%= c.id %></td>
                      <td>
                        <span class="badge <%= c.level === 1 ? 'badge-success' : 'badge-working' %>">
                          Level <%= c.level %>
                        </span>
                      </td>
                      <td><strong><%= c.buyer_username %></strong> (<%= c.buyer_code %>)</td>
                      <td>$<%= c.package_amount.toFixed(2) %></td>
                      <td><span class="badge badge-success"><%= c.commission_pct %>%</span></td>
                      <td style="font-weight: 700; color: var(--c-mint);">+$<%= c.net_amount.toFixed(2) %></td>
                      <td><span class="badge badge-success"><%= c.status %></span></td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(c.created_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 2.5rem;">
                      No referral commissions earned yet. Build your direct and indirect network to receive up to 5 levels of one-time referral commissions (5%, 2%, 1%, 1%, 1%)!
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
