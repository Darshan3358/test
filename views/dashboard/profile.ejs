<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Profile & Security' }) %>

      <main class="dashboard-content">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="grid grid-2">
          <!-- Profile Information Form -->
          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <span>Account Information</span>
              </div>
              <% if (user.user_type === 'WORKING') { %>
                <span class="badge badge-working">Working ID (3X)</span>
              <% } else if (user.user_type === 'INVESTOR') { %>
                <span class="badge badge-investor">Investor ID (2X)</span>
              <% } else if (user.user_type === 'SUSPENDED') { %>
                <span class="badge badge-error">Suspended</span>
              <% } else { %>
                <span class="badge badge-active">Active ID</span>
              <% } %>
            </div>

            <form action="/profile" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="form-group">
                <label class="form-label">Unique User Code</label>
                <input type="text" class="form-input" value="<%= user.user_code %>" readonly style="color: var(--c-mint); font-weight: 700;">
              </div>

              <div class="form-group">
                <label class="form-label">Username</label>
                <input type="text" class="form-input" value="<%= user.username %>" readonly>
              </div>

              <div class="form-group">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-input" value="<%= user.full_name %>" required>
              </div>

              <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-input" value="<%= user.email %>" readonly>
              </div>

              <div class="form-group">
                <label class="form-label">Mobile Number</label>
                <input type="text" name="mobile" class="form-input" value="<%= user.mobile || '' %>" placeholder="+123456789">
              </div>

              <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                  <label class="form-label" style="margin-bottom: 0;">Default USDT BEP-20 Payout Address (BNB Smart Chain)</label>
                  <button type="button" class="btn-icon-link" id="btn-use-wallet-profile" style="font-size: 0.75rem; color: var(--c-mint); cursor: pointer; background: transparent; border: none;">
                    ⚡ Use Connected Wallet
                  </button>
                </div>
                <input type="text" name="walletAddress" id="profileWalletInput" class="form-input mono" value="<%= profile.wallet_address || '' %>" placeholder="0x... (42-character BEP-20 address)" pattern="^0x[a-fA-F0-9]{40}$">
              </div>

              <div class="form-group">
                <label class="form-label">Bank Wire / Alternate Account Details</label>
                <textarea name="bankDetails" class="form-textarea" rows="2"><%= profile.bank_details || '' %></textarea>
              </div>

              <div class="form-group">
                <label class="form-label">Personal Bio</label>
                <input type="text" name="bio" class="form-input" value="<%= profile.bio || '' %>">
              </div>

              <button type="submit" class="btn btn-primary btn-block">Save Profile Details</button>
            </form>
          </div>

          <!-- Security Information Card -->
          <div class="card" style="background: var(--grad-card); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="card-header">
                <div class="card-title">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                  <span>Security & Login Activity</span>
                </div>
              </div>

              <div style="margin-bottom: 1.5rem;">
                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">Last Login Timestamp:</div>
                <div style="font-weight: 600;"><%= security.last_login_at ? new Date(security.last_login_at).toLocaleString() : 'Just now' %></div>
              </div>

              <div style="margin-bottom: 1.5rem;">
                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">Last Known IP:</div>
                <div style="font-family: monospace; color: var(--c-mint);"><%= security.last_login_ip || '127.0.0.1' %></div>
              </div>

              <div style="margin-bottom: 1.5rem;">
                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">Two-Factor Authentication (2FA):</div>
                <span class="badge badge-success">Enabled (Standard)</span>
              </div>
            </div>

            <div style="border-top: 1px solid var(--border-subtle); padding-top: 1.5rem;">
              <a href="/logout" class="btn btn-outline btn-block text-error">Sign Out of All Sessions</a>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnUseWallet = document.getElementById('btn-use-wallet-profile');
      const input = document.getElementById('profileWalletInput');
      if (btnUseWallet && input) {
        btnUseWallet.addEventListener('click', async () => {
          if (window.FinvoraWeb3 && window.FinvoraWeb3.account) {
            input.value = window.FinvoraWeb3.account;
            btnUseWallet.textContent = '✓ Filled from Wallet';
            setTimeout(() => btnUseWallet.textContent = '⚡ Use Connected Wallet', 2500);
          } else if (window.FinvoraWeb3) {
            try {
              const acc = await window.FinvoraWeb3.connect();
              if (acc) {
                input.value = acc;
                btnUseWallet.textContent = '✓ Filled from Wallet';
                setTimeout(() => btnUseWallet.textContent = '⚡ Use Connected Wallet', 2500);
              }
            } catch (e) {
              console.warn(e);
            }
          }
        });
      }
    });
  </script>
</body>
</html>
