<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Multi-Wallet Accounting' }) %>

      <main class="dashboard-content">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <!-- Multi-Wallet Grid -->
        <div class="kpi-grid" style="margin-bottom: 2rem;">
          <div class="kpi-card" style="border-color: var(--c-teal);">
            <div class="kpi-title">Main Wallet (Available)</div>
            <div class="kpi-value grad-text">$<%= wallet.main_balance.toFixed(2) %> USDT</div>
            <div class="kpi-sub">Ready for package purchase or withdrawal</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">ROI Wallet</div>
            <div class="kpi-value">$<%= wallet.roi_balance.toFixed(2) %></div>
            <div class="kpi-sub">Earned from 2% daily profit</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">Referral Wallet</div>
            <div class="kpi-value">$<%= wallet.referral_balance.toFixed(2) %></div>
            <div class="kpi-sub">Earned from 10% direct sponsor bonus</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">Level Wallet</div>
            <div class="kpi-value">$<%= wallet.level_balance.toFixed(2) %></div>
            <div class="kpi-sub">Earned from 20-level ROI-on-ROI overrides</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">Salary Wallet</div>
            <div class="kpi-value">$<%= wallet.salary_balance.toFixed(2) %></div>
            <div class="kpi-sub">Earned from weekly leadership payouts</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">Total Withdrawn</div>
            <div class="kpi-value text-muted">$<%= (wallet.total_withdrawn || 0).toFixed(2) %></div>
            <div class="kpi-sub">Cumulative completed payouts</div>
          </div>
        </div>

        <!-- Transfer from Income Wallets to Main Wallet -->
        <div class="grid grid-2" style="margin-bottom: 2rem;">
          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                <span>Transfer to Main Wallet</span>
              </div>
            </div>
            <p class="text-secondary" style="font-size: 0.85rem; margin-bottom: 1.25rem;">
              Move earnings from your income wallets into your Main Wallet for package upgrades or withdrawal requests.
            </p>

            <form action="/wallet/transfer" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="form-group">
                <label class="form-label">Transfer From Wallet</label>
                <select name="fromWallet" class="form-select" required>
                  <option value="ROI">ROI Wallet ($<%= wallet.roi_balance.toFixed(2) %> available)</option>
                  <option value="REFERRAL">Referral Wallet ($<%= wallet.referral_balance.toFixed(2) %> available)</option>
                  <option value="LEVEL">Level Wallet ($<%= wallet.level_balance.toFixed(2) %> available)</option>
                  <option value="SALARY">Salary Wallet ($<%= wallet.salary_balance.toFixed(2) %> available)</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Transfer Amount ($ USDT)</label>
                <input type="number" step="0.01" min="1" name="amount" class="form-input" placeholder="e.g. 50.00" required>
              </div>

              <button type="submit" class="btn btn-primary btn-block">Transfer to Main Wallet</button>
            </form>
          </div>

          <!-- Quick Actions & Security Notice -->
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="card-header">
                <div class="card-title">
                  <span>Fast Financial Operations</span>
                </div>
              </div>
              <p class="text-secondary" style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.5rem;">
                All balances are maintained through immutable, double-entry transaction ledgers with strict cryptographically verifiable balances before and after every operation.
              </p>
            </div>

            <div style="display: flex; gap: 1rem;">
              <a href="/deposit" class="btn btn-primary btn-block">Deposit Funds</a>
              <a href="/withdraw" class="btn btn-outline btn-block">Request Withdrawal</a>
            </div>
          </div>
        </div>

        <!-- Wallet Transactions Table -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span>Recent Wallet Activity</span>
            </div>
            <a href="/transactions" class="btn btn-outline btn-sm">Full History</a>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Tx Code</th>
                  <th>Wallet</th>
                  <th>Type</th>
                  <th>Action</th>
                  <th>Amount</th>
                  <th>Balance After</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentTxns && recentTxns.length > 0) { %>
                  <% recentTxns.forEach(tx => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint);"><%= tx.transaction_code %></td>
                      <td><%= tx.wallet_type %></td>
                      <td><span class="badge badge-working"><%= tx.transaction_type %></span></td>
                      <td>
                        <span class="badge <%= tx.action === 'CREDIT' ? 'badge-success' : 'badge-error' %>">
                          <%= tx.action %>
                        </span>
                      </td>
                      <td style="font-weight: 700; color: <%= tx.action === 'CREDIT' ? 'var(--c-mint)' : 'var(--c-error)' %>;">
                        <%= tx.action === 'CREDIT' ? '+' : '-' %>$<%= tx.amount.toFixed(2) %>
                      </td>
                      <td>$<%= tx.balance_after.toFixed(2) %></td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(tx.created_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; color: var(--text-secondary); padding: 2rem;">No wallet transactions yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
