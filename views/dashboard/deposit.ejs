<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    .wallet-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .balance-pill {
      background: rgba(13, 20, 24, 0.85);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
      position: relative;
      overflow: hidden;
    }
    .balance-pill::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 60px; height: 60px;
      background: radial-gradient(circle, rgba(0, 240, 255, 0.1) 0%, transparent 70%);
    }
    .quick-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      border-radius: 20px;
      padding: 0.35rem 0.85rem;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .quick-chip:hover {
      background: rgba(0, 240, 255, 0.15);
      color: #00F0FF;
      border-color: #00F0FF;
    }
    .status-stepper {
      display: none;
      background: rgba(8, 12, 16, 0.95);
      border: 1px solid rgba(0, 240, 255, 0.4);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      margin-top: 1rem;
      animation: fadeIn 0.3s ease;
    }
    .step-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.85rem;
      margin-bottom: 0.65rem;
      color: var(--text-secondary);
    }
    .step-item.active {
      color: #00F0FF;
      font-weight: 700;
    }
    .step-item.done {
      color: #10B981;
    }
    .step-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      border: 1px solid var(--border);
    }
    .step-item.active .step-icon {
      border-color: #00F0FF;
      background: rgba(0, 240, 255, 0.2);
    }
    .step-item.done .step-icon {
      border-color: #10B981;
      background: rgba(16, 185, 129, 0.2);
      color: #10B981;
    }
  </style>
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Deposit Capital (USDT BEP-20)' }) %>

      <main class="dashboard-content">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger" style="margin-bottom: 1.5rem;"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success" style="margin-bottom: 1.5rem;"><%= success %></div>
        <% } %>

        <!-- Protocol Notice Banner: Strict USDT BEP-20 Network -->
        <div style="background: rgba(0, 240, 255, 0.05); border: 1px solid rgba(0, 240, 255, 0.25); border-radius: var(--radius-sm); padding: 0.85rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #26A17B; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; color: #000;">₮</div>
            <div>
              <div style="font-weight: 700; color: #FFFFFF; font-size: 0.95rem;">Official USDT (BEP-20) Payment Channel &bull; BNB Smart Chain</div>
              <div style="font-size: 0.8rem; color: var(--text-secondary);">Direct wallet-to-wallet transfer to FINVORA single active admin treasury. No custom smart contracts, no token approval risks.</div>
            </div>
          </div>
          <span class="badge badge-success" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">Chain ID: 56 (BSC Mainnet)</span>
        </div>

        <!-- Section: User Connected Web3 Wallet & Dual Balances -->
        <div class="wallet-card-grid">
          <!-- Card 1: Connected User Wallet Status -->
          <div class="balance-pill" id="user-wallet-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Connected Web3 Wallet</span>
              <span id="wallet-status-badge" class="badge <%= userVerifiedWallet && userVerifiedWallet.isVerified ? 'badge-success' : 'badge-warning' %>">
                <%= userVerifiedWallet && userVerifiedWallet.isVerified ? '✓ Cryptographically Verified' : 'Not Connected' %>
              </span>
            </div>

            <div id="wallet-address-display" class="mono" style="font-size: 0.95rem; color: #00F0FF; word-break: break-all; margin-bottom: 0.75rem;">
              <%= userVerifiedWallet ? userVerifiedWallet.walletAddress : 'No active wallet connected' %>
            </div>

            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
              <button type="button" class="btn btn-primary btn-sm" id="btn-connect-user-wallet" style="<%= userVerifiedWallet && userVerifiedWallet.isVerified ? 'display: none;' : '' %>">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span>Connect & Verify Wallet</span>
              </button>

              <button type="button" class="btn btn-outline btn-sm" id="btn-disconnect-user-wallet" style="<%= userVerifiedWallet && userVerifiedWallet.isVerified ? '' : 'display: none;' %>">
                <span>Disconnect</span>
              </button>

              <button type="button" class="btn btn-outline btn-sm" id="btn-refresh-balances" style="<%= userVerifiedWallet && userVerifiedWallet.isVerified ? '' : 'display: none;' %>" title="Refresh live balances">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>

          <!-- Card 2: Blockchain USDT Balance (In Connected Wallet) -->
          <div class="balance-pill">
            <div style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.5rem;">
              Wallet USDT Balance (On-Chain)
            </div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.4rem;">
              <div id="onchain-usdt-balance" style="font-size: 1.75rem; font-weight: 800; color: #26A17B;">0.00</div>
              <span style="font-size: 0.9rem; color: var(--text-secondary);">USDT (BEP-20)</span>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
              Gas Reserve: <span id="onchain-bnb-balance" class="mono text-mint">0.0000</span> BNB
            </div>
          </div>

          <!-- Card 3: FINVORA Main Wallet Balance (Internal Ledger) -->
          <div class="balance-pill">
            <div style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.5rem;">
              FINVORA Internal Balance
            </div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.4rem;">
              <div style="font-size: 1.75rem; font-weight: 800; color: #00F0FF;">$<%= Number(wallet ? wallet.main_balance : 0).toFixed(2) %></div>
              <span style="font-size: 0.9rem; color: var(--text-secondary);">USDT</span>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
              Available for Package Purchase &bull; 100% Capital Principal
            </div>
          </div>
        </div>

        <div class="grid grid-2" style="margin-bottom: 2rem;">
          <!-- Panel 1: Direct Web3 Instant Deposit -->
          <div class="card" style="background: var(--grad-card);">
            <div class="card-header">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                <span>Direct Web3 USDT Deposit</span>
              </div>
              <span class="badge badge-success">Instant Transfer</span>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">
                Transfer USDT directly from your verified wallet to the FINVORA treasury with a single wallet confirmation.
              </div>

              <div class="form-group">
                <label class="form-label" style="display: flex; justify-content: space-between;">
                  <span>Deposit Amount (USDT) *</span>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">Min: 10 USDT</span>
                </label>
                <input type="number" id="web3-deposit-amount" class="form-input" placeholder="Enter amount (e.g. 100)" min="10" step="any" required>
              </div>

              <!-- Quick Amount Selectors -->
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
                <button type="button" class="quick-chip" data-amt="50">+50</button>
                <button type="button" class="quick-chip" data-amt="100">+100</button>
                <button type="button" class="quick-chip" data-amt="500">+500</button>
                <button type="button" class="quick-chip" data-amt="1000">+1000</button>
                <button type="button" class="quick-chip" id="btn-chip-max">MAX</button>
              </div>

              <button type="button" id="btn-execute-web3-deposit" class="btn btn-primary btn-block btn-lg" style="box-shadow: 0 0 20px rgba(0, 240, 255, 0.25);">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span>Deposit USDT via Web3</span>
              </button>

              <!-- Real-time Progress Stepper -->
              <div id="deposit-stepper" class="status-stepper">
                <div class="step-item" id="step-confirm">
                  <div class="step-icon">1</div>
                  <span class="step-text">Confirm transfer in your wallet...</span>
                </div>
                <div class="step-item" id="step-broadcast">
                  <div class="step-icon">2</div>
                  <span class="step-text">Broadcasting transaction to BNB Smart Chain...</span>
                </div>
                <div class="step-item" id="step-verify">
                  <div class="step-icon">3</div>
                  <span class="step-text">Verifying receipt and crediting FINVORA balance...</span>
                </div>
                <div id="stepper-result-msg" style="margin-top: 0.75rem; font-size: 0.85rem; font-weight: 700;"></div>
              </div>
            </div>

            <div style="font-size: 0.78rem; color: var(--text-muted); border-top: 1px solid var(--border-subtle); padding-top: 0.75rem;">
              Recipient: <span class="mono text-mint"><%= activeAdminWallet %></span> (Official Single Treasury Wallet)
            </div>
          </div>

          <!-- Panel 2: Manual / External Wallet Transfer & Verification -->
          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Manual Transfer & TxID Verification</span>
              </div>
              <span class="badge badge-outline">Fallback</span>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
                If transferring from a mobile wallet or exchange, send <strong>USDT (BEP-20)</strong> to the active address below, then verify the TxID:
              </div>

              <!-- Treasury Address Box -->
              <label class="form-label">FINVORA Active Receiving Wallet:</label>
              <div id="active-deposit-addr-box" style="background: #080C0D; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.75rem; font-family: monospace; font-size: 0.82rem; color: #00F0FF; word-break: break-all; margin-bottom: 0.5rem;">
                <%= activeAdminWallet %>
              </div>

              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
                <button type="button" class="btn btn-outline btn-xs" id="btn-copy-deposit-addr">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  <span>Copy Address</span>
                </button>
                <a href="https://bscscan.com/address/<%= activeAdminWallet %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-xs">
                  <span>View on BscScan ↗</span>
                </a>
              </div>

              <!-- Manual Verification Form -->
              <form action="/deposit/verify" method="POST" id="form-verify-txid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                  <label class="form-label">BSC Transaction Hash (TxID) *</label>
                  <input type="text" name="txHash" id="manual-tx-hash" class="form-input mono" placeholder="0x... (66-character hex hash)" required>
                  <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Sender address must match your verified wallet (<%= userVerifiedWallet ? userVerifiedWallet.walletAddress.slice(0, 8) + '...' : 'Connect wallet first' %>).</div>
                </div>

                <button type="submit" class="btn btn-outline btn-block" id="btn-submit-manual-tx">
                  <span>Verify On-Chain & Credit Balance</span>
                </button>
              </form>
            </div>

            <div style="font-size: 0.78rem; color: #EF4444; border-top: 1px solid var(--border-subtle); padding-top: 0.65rem;">
              Warning: Send strictly USDT via BNB Smart Chain (BEP-20). Unsupported tokens or networks cannot be recovered.
            </div>
          </div>
        </div>

        <!-- Recent Deposit History Ledger -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Recent Deposit Transactions</span>
            </div>
            <span class="badge badge-success">USDT (BEP-20)</span>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Deposit ID</th>
                  <th>Amount</th>
                  <th>Network</th>
                  <th>Transaction Hash (TxID)</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof deposits !== 'undefined' && deposits && deposits.length > 0) { %>
                  <% deposits.forEach(d => { %>
                    <tr>
                      <td class="mono" style="color: #00F0FF; font-weight: 700;"><%= d.deposit_code %></td>
                      <td style="font-weight: 700; color: #FFFFFF;">$<%= Number(d.amount).toFixed(2) %> USDT</td>
                      <td><span class="badge badge-success">BSC (BEP-20)</span></td>
                      <td class="mono" style="font-size: 0.8rem;">
                        <% if (d.transaction_reference && d.transaction_reference.startsWith('0x')) { %>
                          <a href="https://bscscan.com/tx/<%= d.transaction_reference %>" target="_blank" rel="noopener noreferrer" style="color: #00F0FF; text-decoration: underline;">
                            <%= d.transaction_reference.slice(0, 10) %>...<%= d.transaction_reference.slice(-8) %> ↗
                          </a>
                        <% } else { %>
                          <%= d.transaction_reference || 'N/A' %>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge <%= d.status === 'APPROVED' ? 'badge-success' : (d.status === 'PENDING' ? 'badge-warning' : 'badge-error') %>">
                          <%= d.status %>
                        </span>
                      </td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(d.created_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 2.5rem;">No deposit transactions found. Connect your wallet above to make your first deposit.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/dashboard.js"></script>
  <script src="/js/finvora-web3.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const activeAdminWallet = '<%= activeAdminWallet %>';
      let userVerifiedAddress = '<%= userVerifiedWallet ? userVerifiedWallet.walletAddress : "" %>';

      const btnConnect = document.getElementById('btn-connect-user-wallet');
      const btnDisconnect = document.getElementById('btn-disconnect-user-wallet');
      const btnRefresh = document.getElementById('btn-refresh-balances');
      const usdtBalEl = document.getElementById('onchain-usdt-balance');
      const bnbBalEl = document.getElementById('onchain-bnb-balance');
      const walletAddrEl = document.getElementById('wallet-address-display');
      const walletBadgeEl = document.getElementById('wallet-status-badge');
      const copyBtn = document.getElementById('btn-copy-deposit-addr');
      const addrBox = document.getElementById('active-deposit-addr-box');
      const depositAmtInput = document.getElementById('web3-deposit-amount');
      const btnExecuteDeposit = document.getElementById('btn-execute-web3-deposit');
      const stepper = document.getElementById('deposit-stepper');
      const stepConfirm = document.getElementById('step-confirm');
      const stepBroadcast = document.getElementById('step-broadcast');
      const stepVerify = document.getElementById('step-verify');
      const stepperMsg = document.getElementById('stepper-result-msg');

      // Fetch and display live balances
      async function updateBalances(address) {
        if (!address || !window.finvoraWeb3) return;
        try {
          const balances = await window.finvoraWeb3.getBalances(address);
          if (usdtBalEl) usdtBalEl.textContent = (balances.usdt || 0).toFixed(2);
          if (bnbBalEl) bnbBalEl.textContent = (balances.bnb || 0).toFixed(4);
        } catch (e) {
          console.warn('Failed to load balances:', e);
        }
      }

      if (userVerifiedAddress) {
        updateBalances(userVerifiedAddress);
      }

      // Connect Wallet button handler
      if (btnConnect) {
        btnConnect.addEventListener('click', async () => {
          btnConnect.disabled = true;
          btnConnect.innerHTML = '<span>Connecting...</span>';

          try {
            const res = await window.finvoraWeb3.connectAndVerify({ role: 'user' });
            userVerifiedAddress = res.account;
            walletAddrEl.textContent = userVerifiedAddress;
            walletBadgeEl.className = 'badge badge-success';
            walletBadgeEl.textContent = '✓ Cryptographically Verified';
            btnConnect.style.display = 'none';
            if (btnDisconnect) btnDisconnect.style.display = 'inline-flex';
            if (btnRefresh) btnRefresh.style.display = 'inline-flex';
            await updateBalances(userVerifiedAddress);
          } catch (err) {
            alert('Wallet connection failed: ' + err.message);
          } finally {
            btnConnect.disabled = false;
            btnConnect.innerHTML = '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg><span>Connect & Verify Wallet</span>';
          }
        });
      }

      // Disconnect button handler
      if (btnDisconnect) {
        btnDisconnect.addEventListener('click', async () => {
          if (!confirm('Disconnect your wallet from FINVORA?')) return;
          await window.finvoraWeb3.disconnect({ role: 'user' });
          window.location.reload();
        });
      }

      // Refresh button
      if (btnRefresh) {
        btnRefresh.addEventListener('click', () => updateBalances(userVerifiedAddress));
      }

      // Quick amount chips
      document.querySelectorAll('.quick-chip[data-amt]').forEach(chip => {
        chip.addEventListener('click', () => {
          const add = parseFloat(chip.dataset.amt);
          const current = parseFloat(depositAmtInput.value) || 0;
          depositAmtInput.value = (current + add).toFixed(2);
        });
      });

      const maxBtn = document.getElementById('btn-chip-max');
      if (maxBtn) {
        maxBtn.addEventListener('click', () => {
          const bal = parseFloat(usdtBalEl?.textContent || '0');
          if (bal > 0) depositAmtInput.value = bal.toFixed(2);
        });
      }

      // Execute Direct Web3 Deposit
      if (btnExecuteDeposit) {
        btnExecuteDeposit.addEventListener('click', async () => {
          if (!userVerifiedAddress) {
            alert('Please connect and verify your Web3 wallet first.');
            btnConnect?.click();
            return;
          }

          const amount = parseFloat(depositAmtInput.value);
          if (!amount || amount < 10) {
            alert('Please specify a valid deposit amount (Minimum: 10 USDT).');
            depositAmtInput.focus();
            return;
          }

          btnExecuteDeposit.disabled = true;
          stepper.style.display = 'block';
          stepperMsg.textContent = '';
          stepConfirm.className = 'step-item active';
          stepBroadcast.className = 'step-item';
          stepVerify.className = 'step-item';

          try {
            await window.finvoraWeb3.executeDepositTransfer({
              adminWallet: activeAdminWallet,
              amountUsdt: amount,
              onProgress: (stage, data) => {
                if (stage === 'CONFIRM_WALLET') {
                  stepConfirm.className = 'step-item active';
                } else if (stage === 'BROADCASTING') {
                  stepConfirm.className = 'step-item done';
                  stepBroadcast.className = 'step-item active';
                  if (data.txHash) {
                    stepBroadcast.querySelector('.step-text').innerHTML = `Broadcasted! TxID: <span class="mono">${data.txHash.slice(0, 10)}...</span>`;
                  }
                } else if (stage === 'VERIFYING') {
                  stepBroadcast.className = 'step-item done';
                  stepVerify.className = 'step-item active';
                } else if (stage === 'SUCCESS') {
                  stepVerify.className = 'step-item done';
                  stepperMsg.style.color = '#10B981';
                  stepperMsg.textContent = '✓ ' + (data.message || 'Deposit confirmed and credited to your Main Wallet!');
                  setTimeout(() => window.location.reload(), 2500);
                }
              }
            });
          } catch (err) {
            stepperMsg.style.color = '#EF4444';
            stepperMsg.textContent = 'Deposit failed: ' + err.message;
            btnExecuteDeposit.disabled = false;
          }
        });
      }

      // Copy address handler
      if (copyBtn && addrBox) {
        copyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(addrBox.textContent.trim()).then(() => {
            const orig = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>✓ Copied!</span>';
            setTimeout(() => copyBtn.innerHTML = orig, 2000);
          });
        });
      }
    });
  </script>
</body>
</html>
