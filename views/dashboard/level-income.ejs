<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Level Income (ROI on ROI)' }) %>

      <main class="dashboard-content">
        <!-- Level Earnings Summary Badges -->
        <div class="card" style="margin-bottom: 2rem; background: var(--grad-card);">
          <h2 style="font-size: 1.35rem; margin-bottom: 0.5rem;">20-Tier Residual <span class="grad-text">Overrides</span></h2>
          <p class="text-secondary" style="font-size: 0.9rem;">
            Level income is automatically generated whenever an eligible downline member receives daily ROI yield.
          </p>

          <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.25rem;">
            <% if (levelSummary && levelSummary.length > 0) { %>
              <% levelSummary.forEach(ls => { %>
                <div style="background: rgba(12, 17, 18, 0.8); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.5rem 1rem;">
                  <span class="text-secondary" style="font-size: 0.8rem;">Level <%= ls.level %>:</span>
                  <strong style="color: var(--c-mint); margin-left: 0.4rem;">$<%= Number(ls.total_earned).toFixed(2) %></strong>
                </div>
              <% }); %>
            <% } else { %>
              <div class="text-secondary" style="font-size: 0.9rem;">No level income recorded yet. Build your downline network to unlock overrides!</div>
            <% } %>
          </div>
        </div>

        <!-- Ledger Table -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span>Level Income Commission Ledger</span>
            </div>
            <span class="badge badge-success">Automated Double-Entry</span>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Downline User</th>
                  <th>Level</th>
                  <th>Rate (%)</th>
                  <th>Downline Daily ROI</th>
                  <th>Net Commission</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (commissions && commissions.length > 0) { %>
                  <% commissions.forEach(c => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint);">#LIC-<%= c.id %></td>
                      <td><strong><%= c.downline_username %></strong> (<%= c.downline_code %>)</td>
                      <td><span class="badge badge-working">Level <%= c.level %></span></td>
                      <td class="text-success"><%= c.commission_pct %>%</td>
                      <td>$<%= c.downline_roi_amount.toFixed(2) %></td>
                      <td style="font-weight: 700; color: var(--c-mint);">+$<%= c.net_amount.toFixed(4) %></td>
                      <td><span class="badge badge-success"><%= c.status %></span></td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(c.created_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 2.5rem;">
                      No level commissions recorded yet.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
