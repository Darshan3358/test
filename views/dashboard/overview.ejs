<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .kpi-grid { grid-template-columns: 1fr; } }

    .kpi-card {
      background: var(--grad-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.4rem;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }
    .kpi-card:hover {
      transform: translateY(-3px);
      border-color: rgba(87, 193, 157, 0.4);
      box-shadow: 0 12px 28px -8px rgba(13, 108, 159, 0.25);
    }
    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .kpi-title {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      font-weight: 600;
    }
    .kpi-icon {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      background: rgba(13, 108, 159, 0.15);
      color: var(--c-mint);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .kpi-icon.teal { background: rgba(55, 165, 161, 0.15); color: var(--c-teal); }
    .kpi-icon.green { background: rgba(87, 193, 157, 0.15); color: var(--c-green); }
    .kpi-icon.lime { background: rgba(179, 235, 145, 0.15); color: var(--c-lime); }
    .kpi-value {
      font-size: 1.75rem;
      font-weight: 800;
      font-family: var(--font-heading);
      letter-spacing: -0.02em;
      margin-bottom: 0.25rem;
    }
    .kpi-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .vault-hero-card {
      background: linear-gradient(135deg, rgba(13, 108, 159, 0.2) 0%, rgba(12, 17, 19, 0.95) 100%);
      border: 1px solid rgba(87, 193, 157, 0.3);
      border-radius: var(--radius-lg);
      padding: 1.8rem 2.2rem;
      margin-bottom: 2rem;
      display: grid;
      grid-template-columns: 1.6fr 0.8fr;
      align-items: center;
      gap: 2rem;
      box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.7), 0 0 25px rgba(55, 165, 161, 0.15);
      position: relative;
      overflow: hidden;
    }
    @media (max-width: 850px) {
      .vault-hero-card { grid-template-columns: 1fr; }
    }
    .vault-canvas-container {
      width: 100%;
      height: 160px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    #three-vault-canvas {
      width: 100%;
      height: 100%;
      outline: none;
    }
    .progress-container {
      background: #080D0F;
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      height: 8px;
      overflow: hidden;
      margin-top: 0.5rem;
    }
    .progress-bar-fill {
      height: 100%;
      background: var(--grad-primary);
      border-radius: var(--radius-full);
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 0 10px rgba(87, 193, 157, 0.6);
    }
  </style>
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/dashboard-sidebar') %>

    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', { pageTitle: 'Financial Overview' }) %>

      <main class="dashboard-content">
        <% if (typeof query !== 'undefined' && query && query.welcome) { %>
          <div class="alert alert-success" style="margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
            <div>
              <div style="font-weight: 700; margin-bottom: 0.25rem;">🎉 Welcome to FINVORA! Account Established</div>
              <div style="font-size: 0.88rem; color: #FFFFFF;">
                Your unique system-generated username is <strong class="mono text-mint" style="font-size: 1rem;"><%= user.username %></strong> (User Code: <strong class="mono text-mint"><%= user.user_code %></strong>).
                You can sign in using either this username or your registered email address.
              </div>
            </div>
          </div>
        <% } %>

        <!-- 3D Interactive Quantum Vault Hero Card -->
        <div class="vault-hero-card">
          <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
              <span class="pulse-dot"></span>
              <span class="badge badge-success" style="font-size: 0.72rem;">PROTOCOL ACTIVE</span>
              <span class="mono text-mint" style="font-size: 0.8rem;">NEXT YIELD DROP: <strong id="yield-countdown">04:18:22</strong></span>
            </div>
            <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">
              Welcome back, <span class="grad-text"><%= user.username %></span>
            </h2>
            <p class="text-secondary" style="font-size: 0.92rem; line-height: 1.6; max-width: 540px;">
              Your financial node is active on Tier 
              <% if (user.user_type === 'WORKING') { %>
                <span class="badge badge-working">Working ID (3X)</span>
              <% } else if (user.user_type === 'INVESTOR') { %>
                <span class="badge badge-investor">Investor ID (2X)</span>
              <% } else if (user.user_type === 'SUSPENDED') { %>
                <span class="badge badge-error">Suspended</span>
              <% } else { %>
                <span class="badge badge-active">Active ID</span>
              <% } %>
              with double-entry atomic balance verification.
            </p>

            <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; align-items: center;">
              <a href="/packages" class="btn btn-primary btn-sm">Buy New Package</a>
              <a href="/wallet" class="btn btn-outline btn-sm">Deposit / Withdraw</a>

              <!-- Web3 Wallet-Based Referral Link Widget -->
              <div id="overview-ref-disconnected" style="<%= (typeof walletAddress !== 'undefined' && walletAddress) ? 'display: none;' : 'display: inline-flex;' %> background: rgba(8, 12, 14, 0.85); border: 1px dashed rgba(87, 193, 157, 0.35); border-radius: var(--radius-sm); padding: 0.4rem 0.85rem; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <span class="text-secondary" style="font-size: 0.82rem;">⚡ Connect Web3 Wallet to generate your referral link:</span>
                <button type="button" class="btn btn-web3-connect btn-sm" onclick="window.FinvoraWeb3 ? window.FinvoraWeb3.connect() : null" style="padding: 0.25rem 0.65rem; font-size: 0.78rem;">
                  <span>Connect Wallet</span>
                </button>
              </div>

              <div id="overview-ref-connected" style="<%= (typeof walletAddress !== 'undefined' && walletAddress) ? 'display: inline-flex;' : 'display: none;' %> background: rgba(8, 12, 14, 0.85); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.4rem 0.85rem; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <span class="text-muted" style="font-size: 0.78rem;">Referral Code:</span>
                <span class="mono text-mint" id="overview-ref-wallet" style="font-size: 0.88rem; font-weight: 800;" title="<%= typeof walletAddress !== 'undefined' && walletAddress ? walletAddress : '' %>"><%= typeof walletAddress !== 'undefined' && walletAddress ? (walletAddress.slice(0, 6) + '...' + walletAddress.slice(-4)) : '0x...' %></span>
                <span style="color: var(--border);">|</span>
                <input type="text" id="ref-link-input" readonly value="<%= typeof walletAddress !== 'undefined' && walletAddress ? ((process.env.APP_URL || 'http://localhost:3000') + '/register?ref=' + walletAddress) : '' %>" 
                       style="background: transparent; border: none; color: var(--text-secondary); font-size: 0.82rem; width: 330px; outline: none;" class="mono">
                <button type="button" id="btn-copy-ref" class="btn btn-outline btn-sm" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">
                  Copy Link
                </button>
              </div>
            </div>
          </div>

          <!-- 3D Mini Quantum Orb Canvas -->
          <div class="vault-canvas-container">
            <canvas id="three-vault-canvas"></canvas>
          </div>
        </div>

        <!-- Web3 BSC Protocol Gateway Banner / On-Chain Card -->
        <div id="web3-overview-banner" class="web3-overview-container" style="margin-bottom: 2rem;"></div>

        <!-- 8 Core Financial KPI Cards -->
        <div class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Total Balance</div>
              <div class="kpi-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
            </div>
            <div class="kpi-value grad-text mono">$<%= wallet.total_balance.toFixed(2) %> USDT</div>
            <div class="kpi-sub">Available in Main: $<%= wallet.main_balance.toFixed(2) %> USDT</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Active Investment</div>
              <div class="kpi-icon teal"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg></div>
            </div>
            <div class="kpi-value mono">$<%= invSummary.activeInvested.toFixed(2) %></div>
            <div class="kpi-sub"><%= invSummary.activeCount %> active packages</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Today's ROI Yield</div>
              <div class="kpi-icon green"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg></div>
            </div>
            <div class="kpi-value text-success mono">+$<%= todayRoi.toFixed(2) %></div>
            <div class="kpi-sub">Est. Daily: $<%= invSummary.estimatedDailyRoi.toFixed(2) %>/day</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Total ROI Earned</div>
              <div class="kpi-icon lime"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
            </div>
            <div class="kpi-value mono">$<%= wallet.roi_balance.toFixed(2) %></div>
            <div class="kpi-sub">Cumulative 2% returns</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Referral Income</div>
              <div class="kpi-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></div>
            </div>
            <div class="kpi-value mono">$<%= wallet.referral_balance.toFixed(2) %></div>
            <div class="kpi-sub">Level 1 direct 10% bonus</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Level Income</div>
              <div class="kpi-icon teal"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg></div>
            </div>
            <div class="kpi-value mono">$<%= wallet.level_balance.toFixed(2) %></div>
            <div class="kpi-sub">20-Level ROI overrides</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Salary Income</div>
              <div class="kpi-icon green"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg></div>
            </div>
            <div class="kpi-value mono">$<%= wallet.salary_balance.toFixed(2) %></div>
            <div class="kpi-sub">Weekly leadership payouts</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-header">
              <div class="kpi-title">Levels Unlocked</div>
              <div class="kpi-icon lime"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg></div>
            </div>
            <div class="kpi-value text-mint mono"><%= genealogySummary.unlockedLevels %> / 20</div>
            <div class="kpi-sub"><%= genealogySummary.activeDirects %> active direct referrals</div>
          </div>
        </div>

        <!-- Charts Grid (ROI Payout Trend & Income Distribution) -->
        <div class="grid grid-2" style="margin-bottom: 2rem;">
          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                <span>Daily ROI Yield Trajectory</span>
              </div>
            </div>
            <div style="height: 250px; position: relative;">
              <canvas id="roiHistoryChart"></canvas>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path></svg>
                <span>Income Distribution Breakdown</span>
              </div>
            </div>
            <div style="height: 250px; position: relative;">
              <canvas id="incomeDistChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Active Packages & Income Cap Cards -->
        <div class="card" style="margin-bottom: 2rem;">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              <span>Active Package Holdings & Income Caps</span>
            </div>
            <a href="/packages" class="btn btn-outline btn-sm">Buy Package</a>
          </div>

          <% if (activeInvestments && activeInvestments.length > 0) { %>
            <div class="grid grid-2">
              <% activeInvestments.forEach(inv => { %>
                <% 
                  const progressPct = Math.min(100, Math.round(((inv.total_income_earned || 0) / inv.max_income_cap) * 100)); 
                  const remainingCap = Math.max(0, inv.max_income_cap - (inv.total_income_earned || 0));
                %>
                <div style="background: #080C0D; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.35rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
                    <div style="font-weight: 700; font-size: 1.15rem;"><%= inv.package_name %> (<%= inv.package_code %>)</div>
                    <span class="badge badge-success">ACTIVE</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.6rem;">
                    <span>Base Amount: <strong class="mono">$<%= inv.amount.toFixed(2) %></strong></span>
                    <span>Daily Profit: <strong class="mono text-mint"><%= inv.daily_roi_pct %>% ($<%= (inv.amount * 0.02).toFixed(2) %>/d)</strong></span>
                  </div>

                  <div style="margin-top: 1rem;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.35rem;">
                      <span class="text-secondary">Cap Progress (<%= inv.multiplier %>X):</span>
                      <span class="mono"><strong>$<%= (inv.total_income_earned || 0).toFixed(2) %></strong> / $<%= inv.max_income_cap.toFixed(2) %> (<%= progressPct %>%)</span>
                    </div>
                    <div class="progress-container">
                      <div class="progress-bar-fill" style="width: <%= progressPct %>%;"></div>
                    </div>
                    <div style="font-size: 0.75rem; color: var(--c-mint); margin-top: 0.4rem; text-align: right;" class="mono">
                      $<%= remainingCap.toFixed(2) %> remaining before cap
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div style="text-align: center; padding: 2.5rem 0;" class="text-secondary">
              <p style="margin-bottom: 1.25rem; font-size: 1rem;">You do not have any active investment packages currently yielding returns.</p>
              <a href="/packages" class="btn btn-primary btn-sm">Explore Investment Packages</a>
            </div>
          <% } %>
        </div>

        <!-- Recent Transactions Table -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
              <span>Recent Immutable Ledger Transactions</span>
            </div>
            <a href="/transactions" class="btn btn-outline btn-sm">View Full Ledger</a>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Tx ID</th>
                  <th>Type</th>
                  <th>Wallet</th>
                  <th>Amount</th>
                  <th>Balance After</th>
                  <th>Description</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentTxns && recentTxns.length > 0) { %>
                  <% recentTxns.forEach(tx => { %>
                    <tr>
                      <td class="mono" style="font-size: 0.8rem; color: var(--c-mint);"><%= tx.transaction_code %></td>
                      <td>
                        <span class="badge <%= tx.action === 'CREDIT' ? 'badge-success' : 'badge-error' %>">
                          <%= tx.transaction_type %>
                        </span>
                      </td>
                      <td><%= tx.wallet_type %></td>
                      <td class="mono" style="font-weight: 700; color: <%= tx.action === 'CREDIT' ? 'var(--c-mint)' : 'var(--c-error)' %>;">
                        <%= tx.action === 'CREDIT' ? '+' : '-' %>$<%= tx.amount.toFixed(2) %>
                      </td>
                      <td class="mono">$<%= tx.balance_after.toFixed(2) %></td>
                      <td style="max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.85rem; color: var(--text-secondary);">
                        <%= tx.description %>
                      </td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(tx.created_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; color: var(--text-secondary); padding: 2rem;">No transactions recorded yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    // Yield Countdown Timer logic
    (function() {
      const countdownEl = document.getElementById('yield-countdown');
      if (!countdownEl) return;

      function updateCountdown() {
        const now = new Date();
        const tomorrow = new Date(now);
        tomorrow.setUTCHours(24, 0, 0, 0);
        const diff = tomorrow - now;

        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        const seconds = Math.floor((diff / 1000) % 60);

        countdownEl.textContent = 
          String(hours).padStart(2, '0') + ':' + 
          String(minutes).padStart(2, '0') + ':' + 
          String(seconds).padStart(2, '0');
      }

      setInterval(updateCountdown, 1000);
      updateCountdown();
    })();

    // Copy Referral Link
    const copyBtn = document.getElementById('btn-copy-ref');
    const refInput = document.getElementById('ref-link-input');
    if (copyBtn && refInput) {
      copyBtn.addEventListener('click', () => {
        refInput.select();
        navigator.clipboard.writeText(refInput.value);
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => copyBtn.textContent = orig, 2000);
      });
    }
  </script>

  <script src="/js/dashboard.js"></script>
  <script src="/js/three-scene.js"></script>
</body>
</html>
