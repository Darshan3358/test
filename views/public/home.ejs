<script>
  // Interactive Calculator Logic
  (function() {
    const range = document.getElementById('calc-range');
    const displayAmt = document.getElementById('calc-amount-display');
    const displayDaily = document.getElementById('calc-daily');
    const displayMonthly = document.getElementById('calc-monthly');
    const displayInvestor = document.getElementById('calc-investor-cap');
    const displayWorking = document.getElementById('calc-working-cap');

    if (!range) return;

    function updateCalc() {
      const val = parseFloat(range.value);
      displayAmt.textContent = '$' + val.toLocaleString() + ' USD';
      
      const daily = val * 0.02;
      const monthly = daily * 30;
      const investorCap = val * 2;
      const workingCap = val * 3;

      displayDaily.textContent = '+$' + daily.toFixed(2);
      displayMonthly.textContent = '+$' + monthly.toFixed(2);
      displayInvestor.textContent = '$' + investorCap.toLocaleString() + '.00';
      displayWorking.textContent = '$' + workingCap.toLocaleString() + '.00';
    }

    range.addEventListener('input', updateCalc);
    updateCalc();
  })();
</script>

