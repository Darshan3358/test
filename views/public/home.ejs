<style>
  .hero-section {
    position: relative;
    min-height: 680px;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 4.5rem 0 3.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3.5rem;
    position: relative;
    z-index: 2;
  }

  .three-canvas-container {
    width: 100%;
    height: 560px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
  }

  #three-hero-canvas {
    width: 100%;
    height: 100%;
    outline: none;
    cursor: grab;
  }

  #three-hero-canvas:active {
    cursor: grabbing;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    background: rgba(13, 108, 159, 0.18);
    border: 1px solid rgba(87, 193, 157, 0.35);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    color: var(--c-mint);
    margin-bottom: 1.5rem;
    box-shadow: 0 0 15px rgba(55, 165, 161, 0.15);
  }

  .hero-title {
    font-size: 3.6rem;
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    max-width: 580px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .stat-banner {
    background: var(--grad-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.2rem 2.8rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: -3.5rem;
    position: relative;
    z-index: 10;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.8), 0 0 30px rgba(55, 165, 161, 0.1);
    backdrop-filter: blur(20px);
  }

  .stat-item h3 {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .stat-item p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 0.3rem;
  }

  /* Interactive Calculator Widget */
  .calc-card {
    background: linear-gradient(180deg, rgba(15, 22, 25, 0.95) 0%, rgba(8, 12, 14, 0.98) 100%);
    border: 1px solid rgba(87, 193, 157, 0.25);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin: 4.5rem auto 0;
    max-width: 1020px;
    box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.8), 0 0 30px rgba(13, 108, 159, 0.15);
  }

  .calc-slider-wrap {
    margin: 2rem 0 2.5rem;
  }

  .calc-range {
    width: 100%;
    height: 8px;
    border-radius: var(--radius-full);
    background: #11181B;
    outline: none;
    -webkit-appearance: none;
    border: 1px solid var(--border);
  }

  .calc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--grad-primary);
    cursor: pointer;
    box-shadow: 0 0 14px rgba(87, 193, 157, 0.7);
    transition: transform 0.15s ease;
  }

  .calc-range::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .calc-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .calc-metric-box {
    background: #080D0F;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    text-align: center;
    transition: all 0.25s ease;
  }

  .calc-metric-box:hover {
    border-color: var(--c-green);
    transform: translateY(-2px);
  }

  .calc-metric-val {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    font-family: var(--font-mono);
    margin-top: 0.35rem;
  }

  .section {
    padding: 6.5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 4.5rem;
  }

  .section-title {
    font-size: 2.8rem;
    margin-bottom: 1.1rem;
  }

  /* Package Cards */
  .package-card {
    background: var(--grad-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.2rem 1.8rem;
    position: relative;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(16px);
  }

  .package-card:hover {
    transform: translateY(-6px) scale(1.015);
    border-color: rgba(87, 193, 157, 0.45);
    box-shadow: 0 20px 45px -15px rgba(13, 108, 159, 0.3), 0 0 25px rgba(87, 193, 157, 0.15);
  }

  .package-card.highlight {
    border-color: rgba(87, 193, 157, 0.5);
    background: linear-gradient(180deg, rgba(18, 28, 31, 0.95) 0%, rgba(8, 12, 14, 0.98) 100%);
    box-shadow: 0 16px 40px -10px rgba(55, 165, 161, 0.2);
  }

  .package-badge-top {
    position: absolute;
    top: -13px;
    right: 24px;
    background: var(--grad-primary);
    color: #050505;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .package-price {
    font-size: 2.8rem;
    font-weight: 800;
    font-family: var(--font-heading);
    margin: 1.25rem 0;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }

  .package-price span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .package-features {
    list-style: none;
    margin-bottom: 2rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }

  .package-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .package-features li svg {
    width: 16px;
    height: 16px;
    color: var(--c-mint);
    flex-shrink: 0;
  }

  .feature-box {
    background: var(--grad-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 2.4rem;
    transition: all 0.3s ease;
  }

  .feature-box:hover {
    transform: translateY(-4px);
    border-color: var(--c-green);
    box-shadow: 0 12px 30px -10px rgba(87, 193, 157, 0.25);
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: rgba(87, 193, 157, 0.12);
    border: 1px solid rgba(87, 193, 157, 0.25);
    color: var(--c-mint);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 992px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-desc { margin: 0 auto 2rem; }
    .hero-actions { justify-content: center; }
    .stat-banner { grid-template-columns: repeat(2, 1fr); margin-top: 2rem; }
    .calc-metrics { grid-template-columns: repeat(2, 1fr); }
    .hero-title { font-size: 2.8rem; }
  }

  @media (max-width: 580px) {
    .stat-banner { grid-template-columns: 1fr; }
    .calc-metrics { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; width: 100%; }
    .hero-actions .btn { width: 100%; }
  }
</style>

