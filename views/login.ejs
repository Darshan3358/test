<%- include('partials/header', { useThree: true }) %>

<style>
  .auth-wrapper {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .auth-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    max-width: 1040px;
    width: 100%;
    background: var(--grad-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.8), 0 0 30px rgba(55, 165, 161, 0.1);
  }

  .auth-visual-panel {
    position: relative;
    background: radial-gradient(circle at 50% 50%, rgba(13, 108, 159, 0.2) 0%, rgba(5, 5, 5, 0.95) 80%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3rem;
    border-right: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .auth-canvas-box {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.85;
  }

  .auth-visual-content {
    position: relative;
    z-index: 2;
  }

  .auth-form-panel {
    padding: 3.5rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(12, 17, 19, 0.85);
    backdrop-filter: blur(16px);
  }

  @media (max-width: 900px) {
    .auth-grid {
      grid-template-columns: 1fr;
    }
    .auth-visual-panel {
      display: none;
    }
    .auth-form-panel {
      padding: 2.5rem 1.8rem;
    }
  }
</style>

<div class="auth-wrapper">
  <div class="auth-grid">
    <!-- 3D Three.js Visual Showcase Side -->
    <div class="auth-visual-panel">
      <div class="auth-canvas-box">
        <canvas id="three-auth-canvas"></canvas>
      </div>

      <div class="auth-visual-content">
        <div class="badge badge-success" style="margin-bottom: 1rem;">
          <span class="pulse-dot"></span>
          <span>Zero-Knowledge Gateway</span>
        </div>
        <h2 style="font-size: 2.2rem; line-height: 1.2; margin-bottom: 1rem;">
          Institutional Yield & <span class="grad-text">Ledger Security</span>
        </h2>
        <p class="text-secondary" style="font-size: 0.95rem; max-width: 380px; line-height: 1.6;">
          Authenticate into your sovereign FINVORA account to monitor real-time 2% daily yields, manage direct referral networks, and execute wallet transactions.
        </p>
      </div>

      <div class="auth-visual-content" style="display: flex; gap: 2rem; border-top: 1px solid var(--border-subtle); padding-top: 1.5rem;">
        <div>
          <div class="mono" style="font-size: 1.4rem; font-weight: 800; color: var(--c-lime);">730%</div>
          <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase;">Annual APY Rate</div>
        </div>
        <div>
          <div class="mono" style="font-size: 1.4rem; font-weight: 800; color: var(--c-mint);">20-LVL</div>
          <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase;">Residual Depth</div>
        </div>
        <div>
          <div class="mono" style="font-size: 1.4rem; font-weight: 800; color: #FFFFFF;">25 WKS</div>
          <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase;">Salary Duration</div>
        </div>
      </div>
    </div>

    <!-- Form Side -->
    <div class="auth-form-panel">
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.85rem;">Client <span class="grad-text">Sign In</span></h2>
        <p class="text-secondary" style="font-size: 0.9rem; margin-top: 0.35rem;">Enter your credentials to access your financial dashboard</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form action="/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">

        <div class="form-group">
          <label class="form-label">Email Address or System Username (e.g. fin99009)</label>
          <input type="text" name="login" id="login-input" class="form-input" placeholder="e.g. fin99009 or name@example.com" required autofocus>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
            Sign in using either your system-generated username (e.g. <strong class="text-mint mono">fin99009</strong>) or your registered email address.
          </div>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <label class="form-label" style="margin-bottom: 0;">Password</label>
          </div>
          <div class="password-input-group">
            <input type="password" name="password" id="password-input" class="form-input" placeholder="••••••••••••" required>
            <button type="button" class="password-toggle-btn" data-target="password-input" aria-label="Show password" title="Show password">
              <svg class="eye-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg class="eye-off-icon" style="display: none;" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1.5rem;">
          <span>Authenticate Session</span>
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center;">
        <span class="text-secondary" style="font-size: 0.88rem;">New to FINVORA?</span>
        <a href="/register" style="color: var(--c-mint); font-weight: 700; font-size: 0.88rem; margin-left: 0.35rem;">Create Account</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/three-scene.js"></script>
<script src="/js/password-toggle.js"></script>

<%- include('partials/footer') %>
