<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/admin-sidebar') %>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle-btn" aria-label="Toggle Navigation Sidebar">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          <div class="topbar-title">Network Users Directory</div>
        </div>
        <div class="topbar-actions">
          <span class="badge badge-success"><%= users.length %> Total Users Listed</span>
        </div>
      </header>

      <main class="dashboard-content">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <!-- Filter & Search Toolbar -->
        <div class="card" style="margin-bottom: 2rem; padding: 1.25rem;">
          <form method="GET" action="/SLXadmin/users" style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <div style="flex: 2; min-width: 220px;">
              <input type="text" name="q" class="form-input" placeholder="Search by username, email, name, or code..." value="<%= search %>">
            </div>

            <div style="flex: 1; min-width: 150px;">
              <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="ACTIVE" <%= status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                <option value="SUSPENDED" <%= status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
              </select>
            </div>

            <div style="flex: 1; min-width: 150px;">
              <select name="type" class="form-select">
                <option value="">All ID Types</option>
                <option value="ACTIVE" <%= userType === 'ACTIVE' ? 'selected' : '' %>>Active ID</option>
                <option value="INVESTOR" <%= userType === 'INVESTOR' ? 'selected' : '' %>>Investor ID (2X)</option>
                <option value="WORKING" <%= userType === 'WORKING' ? 'selected' : '' %>>Working ID (3X)</option>
                <option value="SUSPENDED" <%= userType === 'SUSPENDED' ? 'selected' : '' %>>Suspended ID</option>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">Filter Users</button>
            <% if (search || status || userType) { %>
              <a href="/SLXadmin/users" class="btn btn-outline">Clear Filters</a>
            <% } %>
          </form>
        </div>

        <!-- Users Table -->
        <div class="card">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Username</th>
                  <th>Full Name</th>
                  <th>Sponsor</th>
                  <th>ID Type</th>
                  <th>Main Balance</th>
                  <th>Active Capital</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (users && users.length > 0) { %>
                  <% users.forEach(u => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint);"><%= u.user_code %></td>
                      <td><strong><%= u.username %></strong></td>
                      <td><%= u.full_name %></td>
                      <td style="color: var(--text-secondary);"><%= u.sponsor_username ? '@' + u.sponsor_username : 'None (Root)' %></td>
                      <td>
                        <% if (u.user_type === 'WORKING') { %>
                          <span class="badge badge-working">Working ID</span>
                        <% } else if (u.user_type === 'INVESTOR') { %>
                          <span class="badge badge-investor">Investor ID</span>
                        <% } else if (u.user_type === 'SUSPENDED') { %>
                          <span class="badge badge-error">Suspended</span>
                        <% } else { %>
                          <span class="badge badge-active">Active ID</span>
                        <% } %>
                      </td>
                      <td style="font-weight: 700;">$<%= Number(u.main_balance || 0).toFixed(2) %></td>
                      <td style="font-weight: 700; color: var(--c-mint);">$<%= Number(u.total_invested || 0).toFixed(2) %></td>
                      <td>
                        <span class="badge <%= u.status === 'ACTIVE' ? 'badge-success' : 'badge-error' %>">
                          <%= u.status %>
                        </span>
                      </td>
                      <td>
                        <a href="/SLXadmin/users/<%= u.id %>" class="btn btn-outline btn-sm" style="padding: 0.25rem 0.65rem; font-size: 0.75rem;">
                          Manage
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="9" style="text-align: center; color: var(--text-secondary); padding: 2.5rem;">No users found matching search criteria.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
