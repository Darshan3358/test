<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/admin-sidebar') %>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle-btn" aria-label="Toggle Navigation Sidebar">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          <div class="topbar-title">Security & Administrative Audit Logs</div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="card">
          <div class="card-header">
            <div class="card-title">System Activity Log</div>
            <span class="badge badge-success">Immutable Security Trail</span>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Log ID</th>
                  <th>Actor</th>
                  <th>Role</th>
                  <th>Action</th>
                  <th>Target</th>
                  <th>IP Address</th>
                  <th>Details</th>
                  <th>Timestamp</th>
                </tr>
              </thead>
              <tbody>
                <% if (logs && logs.length > 0) { %>
                  <% logs.forEach(l => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint);">#AUD-<%= l.id %></td>
                      <td><strong><%= l.actor_name || 'System' %></strong></td>
                      <td><span class="badge badge-working"><%= l.actor_role %></span></td>
                      <td><code><%= l.action %></code></td>
                      <td><%= l.target_type ? `${l.target_type} #${l.target_id || ''}` : 'General' %></td>
                      <td style="font-family: monospace; font-size: 0.8rem;"><%= l.ip_address %></td>
                      <td style="font-size: 0.8rem; color: var(--text-secondary); max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <%= l.details || '-' %>
                      </td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(l.created_at).toLocaleString() %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="8" class="text-secondary" style="text-align: center; padding: 2.5rem;">No audit logs recorded yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
