<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/admin-sidebar') %>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle-btn" aria-label="Toggle Navigation Sidebar">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          <div class="topbar-title">Pending Withdrawals Queue (USDT BEP-20)</div>
        </div>
      </header>

      <main class="dashboard-content">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success" style="margin-bottom: 1.5rem;"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger" style="margin-bottom: 1.5rem;"><%= error %></div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              <span>Pending Withdrawals Disbursement Queue</span>
            </div>
            <span class="badge badge-success">USDT &bull; BSC (BEP-20)</span>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Withdrawal ID</th>
                  <th>User</th>
                  <th>Gross Amount</th>
                  <th>Fee (10%)</th>
                  <th>Net Amount</th>
                  <th>Receiving Address</th>
                  <th>Network</th>
                  <th>Token</th>
                  <th>Requested At</th>
                  <th>Status</th>
                  <th>Administrative Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (withdrawals && withdrawals.length > 0) { %>
                  <% withdrawals.forEach(w => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint); font-weight: 700;"><%= w.withdrawal_code %></td>
                      <td>
                        <strong><%= w.username %></strong>
                        <div style="font-size: 0.75rem; color: var(--text-secondary);"><%= w.user_code %></div>
                      </td>
                      <td style="font-weight: 700;">$<%= w.requested_amount.toFixed(2) %></td>
                      <td style="color: var(--c-error);">-$<%= w.fee_amount.toFixed(2) %></td>
                      <td style="font-weight: 800; color: var(--c-mint); font-size: 1.05rem;">$<%= w.net_amount.toFixed(2) %></td>
                      <td style="font-family: monospace; font-size: 0.8rem; max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <% if (w.account_details && w.account_details.startsWith('0x')) { %>
                          <a href="https://bscscan.com/address/<%= w.account_details %>" target="_blank" rel="noopener noreferrer" style="color: var(--c-mint); text-decoration: underline;" title="<%= w.account_details %>">
                            <%= w.account_details.slice(0, 6) %>...<%= w.account_details.slice(-4) %> ↗
                          </a>
                        <% } else { %>
                          <%= w.account_details %>
                        <% } %>
                      </td>
                      <td><span class="badge badge-success" style="font-size: 0.7rem;">BSC</span></td>
                      <td><span class="badge badge-success" style="font-size: 0.7rem;">USDT</span></td>
                      <td style="font-size: 0.78rem; color: var(--text-secondary);"><%= new Date(w.created_at).toLocaleString() %></td>
                      <td>
                        <% 
                          let badgeClass = 'badge-warning';
                          if (w.status === 'COMPLETED' || w.status === 'APPROVED') badgeClass = 'badge-success';
                          else if (w.status === 'REJECTED' || w.status === 'FAILED') badgeClass = 'badge-error';
                          else if (w.status === 'REVIEW_REQUIRED') badgeClass = 'badge-error';
                        %>
                        <span class="badge <%= badgeClass %>">
                          <%= w.status %>
                        </span>
                        <% if (w.status === 'REVIEW_REQUIRED') { %>
                          <div style="font-size: 0.7rem; color: #EF4444; margin-top: 0.2rem; font-weight: 700;">⚠️ Wallet Changed</div>
                        <% } %>
                        <% if (w.tx_hash) { %>
                          <div style="margin-top: 0.2rem; font-size: 0.7rem;">
                            <a href="https://bscscan.com/tx/<%= w.tx_hash %>" target="_blank" rel="noopener noreferrer" style="color: var(--c-mint); text-decoration: underline;">
                              TxID ↗
                            </a>
                          </div>
                        <% } %>
                      </td>
                      <td>
                        <% if (w.status === 'PENDING' || w.status === 'PENDING_ADMIN_APPROVAL' || w.status === 'REVIEW_REQUIRED') { %>
                          <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                            <form action="/SLXadmin/withdrawals/<%= w.id %>/approve" method="POST" onsubmit="return confirm('APPROVE & BROADCAST: Send exact <%= Number(w.net_amount).toFixed(2) %> USDT (BEP-20) to destination <%= w.account_details %> on BNB Smart Chain?');">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.3rem 0.65rem; font-size: 0.75rem; font-weight: 700;">
                                APPROVE & SEND
                              </button>
                            </form>
                            <form action="/SLXadmin/withdrawals/<%= w.id %>/reject" method="POST" onsubmit="return confirm('REJECT: Refund <%= Number(w.requested_amount).toFixed(2) %> USDT back to user profit balance?');">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-outline btn-sm text-error" style="padding: 0.3rem 0.65rem; font-size: 0.75rem;">
                                REJECT
                              </button>
                            </form>
                          </div>
                        <% } else { %>
                          <span style="font-size: 0.78rem; color: var(--text-muted);"><%= w.admin_note || 'Processed' %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="11" class="text-secondary" style="text-align: center; padding: 2.5rem;">No pending withdrawal requests.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
