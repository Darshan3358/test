<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('../partials/admin-sidebar') %>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle-btn" aria-label="Toggle Navigation Sidebar">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          <div class="topbar-title">Deposits Review & Credit Management</div>
        </div>
      </header>

      <main class="dashboard-content">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <div class="card-title">All Deposit Requests</div>
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>User</th>
                  <th>Amount</th>
                  <th>Method</th>
                  <th>Reference / Hash</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Administrative Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (deposits && deposits.length > 0) { %>
                  <% deposits.forEach(d => { %>
                    <tr>
                      <td style="font-family: monospace; color: var(--c-mint);"><%= d.deposit_code %></td>
                      <td><strong><%= d.username %></strong> (<%= d.user_code %>)</td>
                      <td style="font-weight: 700; color: var(--c-mint);">$<%= d.amount.toFixed(2) %></td>
                      <td><span class="badge badge-success"><%= d.payment_method === 'USDT_BEP20' ? 'USDT (BEP-20)' : d.payment_method %></span></td>
                      <td style="font-family: monospace; font-size: 0.8rem; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <% if (d.transaction_reference && d.transaction_reference.startsWith('0x')) { %>
                          <a href="https://bscscan.com/tx/<%= d.transaction_reference %>" target="_blank" rel="noopener noreferrer" style="color: var(--c-mint); text-decoration: underline;" title="<%= d.transaction_reference %>">
                            <%= d.transaction_reference.slice(0, 10) %>...<%= d.transaction_reference.slice(-8) %> ↗
                          </a>
                        <% } else { %>
                          <%= d.transaction_reference || 'None' %>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge <%= d.status === 'APPROVED' ? 'badge-success' : (d.status === 'PENDING' ? 'badge-warning' : 'badge-error') %>">
                          <%= d.status %>
                        </span>
                      </td>
                      <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(d.created_at).toLocaleString() %></td>
                      <td>
                        <% if (d.status === 'PENDING') { %>
                          <div style="display: flex; gap: 0.4rem;">
                            <form action="/SLXadmin/deposits/<%= d.id %>/approve" method="POST">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">
                                Approve & Credit
                              </button>
                            </form>
                            <form action="/SLXadmin/deposits/<%= d.id %>/reject" method="POST">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-outline btn-sm text-error" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">
                                Reject
                              </button>
                            </form>
                          </div>
                        <% } else { %>
                          <span style="font-size: 0.8rem; color: var(--text-muted);"><%= d.admin_note || 'Processed' %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="8" class="text-secondary" style="text-align: center; padding: 2rem;">No deposit requests recorded.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
