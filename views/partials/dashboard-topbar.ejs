<header class="dashboard-topbar">
  <div class="topbar-left">
    <button type="button" class="sidebar-toggle-btn" aria-label="Toggle Sidebar Navigation">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
    <div class="topbar-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></div>
  </div>

  <div class="topbar-actions">
    <div id="topbar-main-balance-container" class="topbar-main-balance" style="background: rgba(87, 193, 157, 0.1); border: 1px solid rgba(87, 193, 157, 0.25); border-radius: var(--radius-sm); padding: 0.35rem 0.75rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; transition: all 0.3s ease;">
      <span class="text-secondary" style="font-weight: 500;">Main:</span>
      <span class="mono text-mint" style="font-weight: 700;">$<span id="topbar-main-balance-val"><%= (typeof wallet !== 'undefined' && wallet) ? Number(wallet.main_balance).toFixed(2) : '0.00' %></span> USDT</span>
    </div>

    <!-- Web3 Wallet Integration Container -->
    <div id="web3-wallet-wrapper" class="web3-wallet-wrapper">
      <!-- Disconnected State: Connect Wallet Button -->
      <button type="button" id="web3-connect-btn" class="btn btn-web3-connect" title="Connect available Web3 wallet (MetaMask, Trust Wallet, etc.)">
        <span class="web3-btn-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h14a2 2 0 002-2v-5zm0 0h-4a2 2 0 100 4h4v-4z"/></svg>
        </span>
        <span id="web3-btn-label">Connect Wallet</span>
      </button>

      <!-- Connected State: Truncated Address & Live USDT/BEP20 Balance (No BSC badge, No Green dot) -->
      <div id="web3-connected-pill" class="web3-connected-pill" style="display: none; padding: 0.4rem 0.85rem; background: rgba(18, 26, 28, 0.8); border: 1px solid rgba(38, 161, 123, 0.35); border-radius: var(--radius-sm); cursor: pointer; align-items: center; gap: 0.5rem;" title="Click to view Web3 wallet details and live on-chain balances">
        <span id="web3-pill-usdt" class="web3-pill-usdt mono" style="color: var(--c-mint); font-weight: 700; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.25rem;">
          <span class="usdt-val">0.000</span>
          <span style="font-size: 0.7rem; opacity: 0.85;">USDT/BEP20</span>
        </span>
        <span id="web3-pill-address" class="web3-address mono" style="font-variant: small-caps; text-transform: lowercase; font-size: 0.82rem; letter-spacing: 0.04em; color: #FFFFFF;">0x...</span>
        <svg class="web3-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: var(--text-secondary);"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </div>
    </div>
  </div>
</header>

<!-- Web3 Wallet Interactive Modal -->
<div id="web3-wallet-modal" class="web3-modal-backdrop">
  <div class="web3-modal-dialog">
    <div class="web3-modal-header">
      <div class="web3-modal-title-group">
        <div class="web3-glow-icon small">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h14a2 2 0 002-2v-5zm0 0h-4a2 2 0 100 4h4v-4z"/></svg>
        </div>
        <div>
          <h3 class="web3-modal-title">Web3 Wallet Node</h3>
          <span class="web3-modal-subtitle">BNB Smart Chain (BSC) Network</span>
        </div>
      </div>
      <button type="button" id="web3-modal-close" class="web3-modal-close-btn" aria-label="Close modal">&times;</button>
    </div>

    <div class="web3-modal-body">
      <!-- Network Warning Alert (Hidden if on BSC) -->
      <div id="web3-modal-network-warning" class="web3-alert-warning" style="display: none;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <div>
          <strong>Wrong Network:</strong> Please switch your wallet to BNB Smart Chain to enable live balances and transactions.
          <div style="margin-top: 0.5rem;">
            <button type="button" id="web3-modal-switch-bsc" class="btn btn-warning btn-xs">Switch to BSC Mainnet</button>
          </div>
        </div>
      </div>

      <!-- Address Box -->
      <div class="web3-account-card">
        <div class="account-card-header">
          <span class="label">Connected Account</span>
          <span id="web3-modal-network" class="badge badge-success">BNB Smart Chain</span>
        </div>
        <div class="account-card-address mono" id="web3-modal-address">0x0000000000000000000000000000000000000000</div>
        <div class="account-card-actions">
          <button type="button" id="web3-modal-copy" class="btn btn-outline btn-xs">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span>Copy Address</span>
          </button>
          <a id="web3-modal-explorer" href="https://bscscan.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-xs">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            <span>View on BscScan</span>
          </a>
        </div>
      </div>

      <!-- Live Balances -->
      <div class="web3-balances-container">
        <div class="balances-header">
          <span class="label">Live On-Chain Balances</span>
          <button type="button" id="web3-modal-refresh" class="btn-icon-link" title="Refresh live balances">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>Refresh</span>
          </button>
        </div>

        <div class="balances-grid" style="grid-template-columns: 1fr;">
          <div class="balance-item usdt-only-card" style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; background: rgba(38, 161, 123, 0.08); border: 1px solid rgba(38, 161, 123, 0.3); border-radius: 12px;">
            <div class="token-meta" style="display: flex; align-items: center; gap: 0.85rem;">
              <div class="token-symbol-badge usdt" style="width: 42px; height: 42px; font-size: 1.1rem; font-weight: 800; background: #26A17B; color: #FFFFFF; display: flex; align-items: center; justify-content: center; border-radius: 10px; box-shadow: 0 4px 12px rgba(38, 161, 123, 0.25);">₮</div>
              <div>
                <span class="token-name" style="font-weight: 700; font-size: 0.95rem; color: #ffffff;">USDT On-Chain Balance</span>
                <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">BNB Smart Chain &bull; BEP-20 Standard</div>
              </div>
            </div>
            <div class="token-val" style="text-align: right;">
              <div style="font-size: 1.35rem; font-weight: 800; color: var(--c-mint); letter-spacing: -0.01em;">
                <span id="web3-modal-usdt" class="mono">0.000</span> <span class="sym" style="font-size: 0.82rem; font-weight: 700;">USDT/BEP20</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="web3-modal-footer">
      <button type="button" id="web3-modal-sync-profile" class="btn btn-outline btn-sm">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>Link to Account Profile</span>
      </button>

      <button type="button" id="web3-modal-disconnect" class="btn btn-danger-outline btn-sm">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span>Disconnect</span>
      </button>
    </div>
  </div>
</div>

<!-- Web3 Install/Discovery Guidance Modal -->
<div id="web3-install-modal" class="web3-modal-backdrop">
  <div class="web3-modal-dialog" style="max-width: 440px;">
    <div class="web3-modal-header">
      <h3 class="web3-modal-title">Web3 Wallet Required</h3>
      <button type="button" id="web3-install-modal-close" class="web3-modal-close-btn">&times;</button>
    </div>
    <div class="web3-modal-body" style="text-align: center; padding: 1.5rem 1rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🦊</div>
      <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem; font-weight: 700;">No EVM Wallet Detected</h4>
      <p class="text-secondary" style="font-size: 0.88rem; line-height: 1.5; margin-bottom: 1.5rem;">
        To connect to the FINVORA BSC protocol, please open this site inside a Web3 browser or install one of the popular crypto wallet extensions:
      </p>

      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <a href="https://metamask.io/download/" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="justify-content: space-between; padding: 0.75rem 1rem;">
          <span style="display: flex; align-items: center; gap: 0.75rem;">
            <strong>MetaMask</strong>
            <span class="badge badge-active" style="font-size: 0.7rem;">Recommended</span>
          </span>
          <span>Install &rarr;</span>
        </a>
        <a href="https://trustwallet.com/download" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="justify-content: space-between; padding: 0.75rem 1rem;">
          <span><strong>Trust Wallet</strong> (Browser & Mobile)</span>
          <span>Install &rarr;</span>
        </a>
        <a href="https://www.binance.com/en/web3wallet" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="justify-content: space-between; padding: 0.75rem 1rem;">
          <span><strong>Binance Web3 Wallet</strong></span>
          <span>Install &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Ethers v6 Local Bundle & FINVORA Web3 Wallet Manager -->
<script src="/vendor/ethers/ethers.umd.min.js" onerror="this.onerror=null;this.src='https://cdnjs.cloudflare.com/ajax/libs/ethers/6.13.2/ethers.umd.min.js';"></script>
<script src="/js/web3-wallet.js" defer></script>

