<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'FINVORA — MLM & Investment Platform' %></title>
  <meta name="description" content="FINVORA — Premier FinTech Investment and MLM Platform with 2% Daily ROI, 20-Level ROI-on-ROI, and Weekly Leadership Salary Plan.">
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="stylesheet" href="/css/main.css">
  <% if (typeof useThree !== 'undefined' && useThree) { %>
    <script src="/vendor/three/three.module.js" type="module"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <% } %>
  <script src="/js/mobile-nav.js" defer></script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo">
        <img src="/assets/logo.svg" alt="FINVORA Logo">
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/packages-info" class="nav-link">Packages</a></li>
        <li><a href="/how-it-works" class="nav-link">How It Works</a></li>
        <li><a href="/income-plan" class="nav-link">Income Plan</a></li>
        <li><a href="/salary-plan" class="nav-link">Salary Plan</a></li>
        <li><a href="/faq" class="nav-link">FAQ</a></li>
      </ul>
      <div class="header-actions">
        <% if (user) { %>
          <a href="<%= user.role === 'ADMIN' ? '/SLXadmin/dashboard' : '/dashboard' %>" class="btn btn-primary btn-sm">
            <span>Dashboard</span>
          </a>
          <a href="/logout" class="btn btn-outline btn-sm">Sign Out</a>
        <% } else { %>
          <a href="/login" class="btn btn-outline btn-sm">Sign In</a>
          <a href="/register" class="btn btn-primary btn-sm">Get Started</a>
        <% } %>
      </div>

      <!-- Mobile & Tablet Hamburger Button -->
      <button type="button" class="mobile-menu-btn" id="public-menu-btn" aria-label="Open Navigation Menu">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </header>

  <!-- Mobile Navigation Sliding Drawer & Backdrop -->
  <div class="public-nav-backdrop" id="public-nav-backdrop"></div>

  <div class="public-mobile-drawer" id="public-mobile-drawer">
    <div class="drawer-header">
      <a href="/" class="brand-logo">
        <img src="/assets/logo.svg" alt="FINVORA">
      </a>
      <button type="button" class="drawer-close-btn" id="public-drawer-close" aria-label="Close Menu">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <ul class="drawer-nav">
      <li><a href="/" class="drawer-link">Home</a></li>
      <li><a href="/packages-info" class="drawer-link">Investment Packages</a></li>
      <li><a href="/how-it-works" class="drawer-link">How It Works</a></li>
      <li><a href="/income-plan" class="drawer-link">Income Plan (4 Streams)</a></li>
      <li><a href="/salary-plan" class="drawer-link">Salary Leadership Plan</a></li>
      <li><a href="/faq" class="drawer-link">Frequently Asked Questions</a></li>
    </ul>

    <div class="drawer-footer">
      <% if (user) { %>
        <a href="<%= user.role === 'ADMIN' ? '/SLXadmin/dashboard' : '/dashboard' %>" class="btn btn-primary btn-block">
          <span>Go to Dashboard</span>
        </a>
        <a href="/logout" class="btn btn-outline btn-block text-error">Sign Out</a>
      <% } else { %>
        <a href="/login" class="btn btn-outline btn-block">Client Sign In</a>
        <a href="/register" class="btn btn-primary btn-block">Create Free Account</a>
      <% } %>
    </div>
  </div>
