{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,data/**,src/database/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/roi",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/salary",
      "schedule": "0 0 * * 1"
    }
  ]
}
